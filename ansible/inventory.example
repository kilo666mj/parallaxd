# parallaxd deployment targets. Copy to `inventory` and fill in real hosts —
# the real file is gitignored, because it is a map of the monitoring fleet and
# this repository is public.
#
# Use ADDRESSES in ansible_host, not names. DNS in the control plane is a
# dependency in the monitoring path: if resolution fails, every prober stops
# submitting and the staleness watchdog reports a fleet-wide prober failure,
# which is a confidently wrong diagnosis of a DNS incident. firewalld rich
# rules take addresses anyway and resolve names only once at creation, so an
# address here keeps one source of truth.
#
# Two groups, and the split matters.
#
# [parallaxd_coordinator] — exactly one host, and not also a prober: a host
# that is both means losing it costs a vantage as well as the decisions.
#
# [parallaxd_probers] — one per PROVIDER, not one per host. Three probers
# behind one provider are one opinion held three times, and the
# distinct_providers quorum rule exists to refuse exactly that. Three is the
# floor: isolation requires having failed to reach at least two peers, so below
# three the partition suppression never fires. Four gives you one spare.

[parallaxd_coordinator]
coordinator  ansible_host=198.51.100.10

[parallaxd_probers]
probe-a  ansible_host=198.51.100.11  parallaxd_provider=provider-one
probe-b  ansible_host=198.51.100.12  parallaxd_provider=provider-two
probe-c  ansible_host=198.51.100.13  parallaxd_provider=provider-three
probe-d  ansible_host=198.51.100.14  parallaxd_provider=provider-four

[parallaxd:children]
parallaxd_coordinator
parallaxd_probers
