{
  "name": "coordinator",
  "listen": "{{ parallaxd_listen }}",
  "key_file": "{{ parallaxd_coordinator_key_file }}",

  "probers": [
{% for host in groups['parallaxd_probers'] %}
    {
      "name": "{{ host }}",
      "url": "http://{{ hostvars[host]['parallaxd_address'] }}:{{ parallaxd_prober_port }}",
      "provider": "{{ hostvars[host]['parallaxd_provider'] }}",
      "public_key": "{{ (parallaxd_coordinator_prober_keys.results | selectattr('item', 'equalto', host) | map(attribute='content') | first | b64decode | trim) }}"
    }{{ "," if not loop.last }}
{% endfor %}
  ],

  "checks": {{ parallaxd_checks | to_nice_json(indent=2) | indent(2) }},
	"components": {{ parallaxd_components | to_nice_json(indent=2) | indent(2) }},
	"maintenance": {{ parallaxd_maintenance | to_nice_json(indent=2) | indent(2) }},
	"state_file": "/var/lib/parallaxd/state.json",
	"session_ttl": "{{ parallaxd_session_ttl }}",
{% if parallaxd_operator_token | trim | length > 0 or inventory_hostname in parallaxd_standby_hosts %}
	"operator_token_file": "{{ parallaxd_key_dir }}/operator-token",
{% endif %}
{% if parallaxd_bootstrap_admin | trim | length > 0 %}
  "bootstrap_admin": {{ parallaxd_bootstrap_admin | to_json }},
  "bootstrap_password_file": "{{ parallaxd_key_dir }}/bootstrap-password",
{% endif %}
{% if parallaxd_oidc_issuer | trim | length > 0 %}
  "oidc": {
    "issuer": {{ parallaxd_oidc_issuer | to_json }},
    "client_id": {{ parallaxd_oidc_client_id | to_json }},
{% if parallaxd_oidc_client_secret | trim | length > 0 %}
    "client_secret_file": "{{ parallaxd_key_dir }}/oidc-client-secret",
{% endif %}
    "redirect_url": {{ parallaxd_oidc_redirect_url | to_json }},
    "username_claim": {{ parallaxd_oidc_username_claim | to_json }},
    "label": {{ parallaxd_oidc_label | to_json }},
    "allow_unverified_email": {{ parallaxd_oidc_allow_unverified_email | to_json }}
  },
{% endif %}

{% if parallaxd_heartbeat_url | length > 0 %}
  "heartbeat": {
    "url": "{{ parallaxd_heartbeat_url }}",
    "interval": "{{ parallaxd_heartbeat_interval }}"{% if parallaxd_heartbeat_headers %},
    "headers": {{ parallaxd_heartbeat_headers | to_json }}{% endif %}

  },
{% endif %}
{% if parallaxd_webhook | length > 0 %}
  "webhook": "{{ parallaxd_webhook }}",
	"webhook_username": {{ parallaxd_webhook_username | to_json }},
	"webhook_channel": {{ parallaxd_webhook_channel | to_json }},
	"webhook_icon_emoji": {{ parallaxd_webhook_icon_emoji | to_json }},
{% if parallaxd_webhook_icon_url | length > 0 %}
	"webhook_icon_url": {{ parallaxd_webhook_icon_url | to_json }},
{% endif %}
{% if parallaxd_webhook_headers %}
  "webhook_headers": {{ parallaxd_webhook_headers | to_json }},
{% endif %}
{% endif %}

{% if parallaxd_notification_destinations | length > 0 %}
  "notification_destinations": {{ parallaxd_notification_destinations | to_json }},
{% endif %}
{% if parallaxd_notification_routes | length > 0 %}
  "notification_routes": {{ parallaxd_notification_routes | to_json }},
{% endif %}
{% if parallaxd_escalations | length > 0 %}
  "escalations": {{ parallaxd_escalations | to_json }},
{% endif %}
  "notification_retry_initial": "{{ parallaxd_notification_retry_initial }}",
  "notification_retry_max": "{{ parallaxd_notification_retry_max }}",
  "notification_retry_interval": "{{ parallaxd_notification_retry_interval }}",
  "history_file": "{{ parallaxd_history_file }}",
  "history_retention": "{{ parallaxd_history_retention }}",
	"history_max_per_check": {{ parallaxd_history_max_per_check }},
{% if parallaxd_standby_hosts | length > 0 %}
  "ha": {
    "role": "{{ 'standby' if inventory_hostname in parallaxd_standby_hosts else 'primary' }}",
{% if inventory_hostname in parallaxd_standby_hosts %}
    "primary_url": "{{ parallaxd_ha_primary_url }}",
{% endif %}
    "replication_token_file": "{{ parallaxd_key_dir }}/replication-token",
    "interval": "{{ parallaxd_ha_replication_interval }}",
    "timeout": "{{ parallaxd_ha_replication_timeout }}"
  },
{% endif %}

  "fan_out_timeout": "{{ parallaxd_fan_out_timeout }}",
  "request_ttl": "{{ parallaxd_request_ttl }}",
  "result_max_age": "{{ parallaxd_result_max_age }}",
  "stale_multiplier": {{ parallaxd_stale_multiplier }},
  "stale_grace": "{{ parallaxd_stale_grace }}",
  "watch_interval": "{{ parallaxd_watch_interval }}",
  "mesh_max_age": "{{ parallaxd_mesh_max_age }}"
}
