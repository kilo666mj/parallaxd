	"webhook_icon_url": {{ parallaxd_watch_webhook_icon_url | to_json }}{% endif %}{% if parallaxd_watch_webhook_headers %},
	"webhook_headers": {{ parallaxd_watch_webhook_headers | to_json }}{% endif %}{% endif %},
