[Interface]
{% if inventory_hostname in parallaxd_internal_prober_hosts %}
Address = {{ parallaxd_address }}/32
{% else %}
Address = {{ parallaxd_ha_standby_address if inventory_hostname in parallaxd_standby_hosts else parallaxd_ha_primary_address }}/32
{% endif %}
PrivateKey = {{ parallaxd_ha_wireguard_private_raw.content | b64decode | trim }}
ListenPort = {{ parallaxd_ha_wireguard_port }}

{% if inventory_hostname in parallaxd_coordinator_nodes %}
# The other coordinator. The primary initiates; the standby learns the return
# endpoint and keeps the HA replication path available behind restrictive NAT.
[Peer]
PublicKey = {{ hostvars[parallaxd_ha_other_coordinator]['parallaxd_ha_wireguard_public_key'] }}
{% if inventory_hostname not in parallaxd_standby_hosts %}
Endpoint = {{ hostvars[parallaxd_standby_hosts[0]]['parallaxd_address'] }}:{{ parallaxd_ha_wireguard_port }}
PersistentKeepalive = 30
AllowedIPs = {{ parallaxd_ha_standby_address }}/32
{% else %}
AllowedIPs = {{ parallaxd_ha_primary_address }}/32
{% endif %}

{% for host in parallaxd_internal_prober_hosts %}
# Internal prober {{ host }} initiates both paths, so no public endpoint is
# needed here and no inbound port is exposed at the private site.
[Peer]
PublicKey = {{ hostvars[host]['parallaxd_ha_wireguard_public_key'] }}
AllowedIPs = {{ hostvars[host]['parallaxd_address'] }}/32

{% endfor %}
{% else %}
# Internal agents initiate tunnels to both coordinators. Other internal probe
# addresses route through the primary hub for peer-mesh reachability.
[Peer]
PublicKey = {{ hostvars[groups['parallaxd_coordinator'][0]]['parallaxd_ha_wireguard_public_key'] }}
Endpoint = {{ hostvars[groups['parallaxd_coordinator'][0]]['parallaxd_address'] }}:{{ parallaxd_ha_wireguard_port }}
AllowedIPs = {{ (([parallaxd_ha_primary_address]
                    + (parallaxd_internal_prober_hosts
                       | reject('equalto', inventory_hostname)
                       | map('extract', hostvars, 'parallaxd_address') | list))
                   | map('regex_replace', '$', '/32') | join(', ')) }}
PersistentKeepalive = 30

[Peer]
PublicKey = {{ hostvars[parallaxd_standby_hosts[0]]['parallaxd_ha_wireguard_public_key'] }}
Endpoint = {{ hostvars[parallaxd_standby_hosts[0]]['parallaxd_address'] }}:{{ parallaxd_ha_wireguard_port }}
AllowedIPs = {{ parallaxd_ha_standby_address }}/32
PersistentKeepalive = 30
{% endif %}
